# Priority Transfers Admin - Environment Configuration

# Firebase Configuration
# Get these values from your Firebase console: Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Application Mode
# Set to 'true' to run in demo mode without a Firebase connection
# Set to 'false' to use a live Firebase database
VITE_DEMO_MODE=true

# Supabase Configuration (optional – only required if using Supabase features)
# Get these values from your Supabase dashboard: Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Setup Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace the placeholder values above with your actual credentials
#    OR leave VITE_DEMO_MODE=true to run without a backend connection
# 3. Start the development server: npm run dev
#
# Need help? Check TROUBLESHOOTING.md for detailed setup instructions